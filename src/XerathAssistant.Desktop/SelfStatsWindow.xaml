<Window x:Class="XerathAssistant.Desktop.SelfStatsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Xerath · Thông tin cá nhân trong trận" Width="680" Height="590"
        MinWidth="590" MinHeight="490" Background="#0B1521" FontFamily="Segoe UI"
        Loaded="WindowLoaded" Closed="WindowClosed">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="20">
      <TextBlock Text="LIVE SELF STATS" FontSize="24" FontWeight="Bold"/>
      <TextBlock Margin="0,6,0,12" Foreground="{StaticResource MutedBrush}"
                 Text="Tự đọc chỉ số CỦA BẠN qua API chính thức trên máy. Không cần nhập thủ công hoặc xem lại video. Không theo dõi đối thủ, không phân tích bản đồ và không đưa ra mệnh lệnh chiến thuật."/>
      <Border Background="#122339" CornerRadius="10" Padding="13" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Name="ConnectionStatus" FontWeight="SemiBold" Text="Đang kiểm tra trận đấu..." />
          <WrapPanel Margin="0,12,0,8">
            <CheckBox Name="RefreshCheck" IsChecked="True" Checked="RefreshChanged" Unchecked="RefreshChanged"
                      Content="Tự cập nhật chỉ số cá nhân mỗi 1 giây"/>
          </WrapPanel>
          <WrapPanel>
            <Button Click="FetchNowClick" Content="Cập nhật ngay" Background="#23705B"/>
            <Button Click="ResetSessionClick" Content="Xóa thống kê phiên"/>
            <Button Name="ToggleHudButton" Click="ToggleHudClick" Background="#23705B"
                    Content="Bật HUD trên game"/>
          </WrapPanel>
          <CheckBox Name="TimeRemindersCheck" IsChecked="False" Margin="0,9,0,0"
                    Content="Hiện thêm lời nhắc theo thời gian trên HUD (mặc định tắt để ưu tiên thông báo theo tình huống)"/>
          <CheckBox Name="EventsCheck" IsChecked="True" Margin="0,9,0,0"
                    Content="Hiện thông báo hạ gục đã xảy ra (không xác định vị trí giao tranh)"/>
          <CheckBox Name="HealthChangeCheck" IsChecked="True" Margin="0,5,0,0"
                    Content="Cảnh báo khi máu của bạn giảm nhanh theo chỉ số trận thực (không đoán vị trí đối thủ)"/>
          <WrapPanel Margin="0,10,0,5">
            <TextBlock Text="Vị trí HUD:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox Name="HudCornerBox" Width="165" SelectionChanged="HudCornerChanged">
              <ComboBoxItem Content="Góc trên phải" Tag="TopRight" IsSelected="True"/>
              <ComboBoxItem Content="Góc trên trái" Tag="TopLeft"/>
              <ComboBoxItem Content="Góc dưới trái" Tag="BottomLeft"/>
              <ComboBoxItem Content="Góc dưới phải" Tag="BottomRight"/>
            </ComboBox>
          </WrapPanel>
          <TextBlock Name="HudHint" Foreground="{StaticResource MutedBrush}"
                     Text="Bật HUD rồi quay lại game ở chế độ Cửa sổ hoặc Không viền. HUD không nhận click chuột và tự ẩn khi game không được chọn."/>
        </StackPanel>
      </Border>
      <Border Background="#122339" CornerRadius="10" Padding="14" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock FontSize="17" FontWeight="SemiBold" Text="Thông tin hiện tại của bạn"/>
          <UniformGrid Columns="2" Margin="0,12,0,0">
            <StackPanel Margin="0,0,10,14">
              <TextBlock Foreground="{StaticResource MutedBrush}" Text="Đồng hồ trận"/>
              <TextBlock Name="GameClock" FontSize="24" FontWeight="Bold" Text="--:--"/>
            </StackPanel>
            <StackPanel Margin="0,0,0,14">
              <TextBlock Foreground="{StaticResource MutedBrush}" Text="Cấp độ"/>
              <TextBlock Name="LevelValue" FontSize="24" FontWeight="Bold" Text="--"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,14">
              <TextBlock Foreground="{StaticResource MutedBrush}" Text="Máu"/>
              <TextBlock Name="HealthValue" FontSize="18" Text="--"/>
              <ProgressBar Name="HealthBar" Minimum="0" Maximum="100" Height="9" Margin="0,6,0,0" Value="0"/>
            </StackPanel>
            <StackPanel Margin="0,0,0,14">
              <TextBlock Name="ResourceLabel" Foreground="{StaticResource MutedBrush}" Text="Năng lượng"/>
              <TextBlock Name="ResourceValue" FontSize="18" Text="--"/>
              <ProgressBar Name="ResourceBar" Minimum="0" Maximum="100" Height="9" Margin="0,6,0,0" Value="0"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,4">
              <TextBlock Foreground="{StaticResource MutedBrush}" Text="Vàng hiện có"/>
              <TextBlock Name="GoldValue" FontSize="20" Text="--"/>
            </StackPanel>
            <StackPanel Margin="0,0,0,4">
              <TextBlock Foreground="{StaticResource MutedBrush}" Text="Sức mạnh phép thuật"/>
              <TextBlock Name="ApValue" FontSize="20" Text="--"/>
            </StackPanel>
          </UniformGrid>
        </StackPanel>
      </Border>
      <Border Background="#122339" CornerRadius="10" Padding="14" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock FontWeight="SemiBold" FontSize="17" Text="Tổng hợp tự động · không cần xem lại video"/>
          <TextBlock Name="SummaryValue" Margin="0,9,0,0"
                     Text="Chưa có dữ liệu. Hãy vào trận và mở cửa sổ này."/>
          <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,9,0,0"
                     Text="Thống kê chỉ dựa vào mẫu đã quan sát khi cửa sổ này mở (khoảng 1 giây/lần); không phải báo cáo đầy đủ của trận. Không lưu dữ liệu cá nhân lên máy chủ."/>
        </StackPanel>
      </Border>
      <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="11"
                 Text="Chỉ truy cập https://127.0.0.1:2999/liveclientdata/activeplayer và gamestats. Có thể không hoạt động khi không ở trong trận. Xerath Support Assistant không được Riot Games chứng thực hoặc tài trợ."/>
    </StackPanel>
  </ScrollViewer>
</Window>
