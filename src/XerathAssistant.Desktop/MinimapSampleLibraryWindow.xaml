<Window x:Class="XerathAssistant.Desktop.MinimapSampleLibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thư viện mẫu minimap V1.8 · Xem và sửa nhãn thủ công"
        Width="870" Height="650" MinWidth="700" MinHeight="510" Background="#0B1521"
        FontFamily="Segoe UI" Loaded="WindowLoaded">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Margin="0,0,0,12">
      <TextBlock Text="THƯ VIỆN MINIMAP V1.8" FontWeight="Bold" FontSize="21" Foreground="White"/>
      <TextBlock Text="Chỉ xem ảnh đã được bạn xác nhận lưu. Mô tả, đội và vai trò vẫn là nhãn thủ công; không phải kết quả AI đã kiểm chứng."
                 TextWrapping="Wrap" Foreground="#F9CF90" Margin="0,6,0,0"/>
    </StackPanel>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="245"/>
        <ColumnDefinition Width="12"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0">
        <TextBlock Text="Ảnh đã lưu" Foreground="White" FontWeight="SemiBold"/>
        <ListBox Name="SampleList" SelectionChanged="SampleSelectionChanged"
                 DisplayMemberPath="Name" MinHeight="200" Margin="0,7,0,8"/>
        <Button Content="Tải lại danh sách" Click="RefreshClick" Padding="8,6"/>
      </StackPanel>
      <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <Image Name="LibraryPreview" MaxHeight="245" MaxWidth="350" Stretch="Uniform"
                 HorizontalAlignment="Left" Margin="0,0,0,8"/>
          <TextBlock Name="SampleDetail" Foreground="#AFC3D8" TextWrapping="Wrap"
                     Text="Hãy chọn một mẫu để xem." Margin="0,0,0,8"/>
          <TextBlock Text="Ghi chú của bạn (3–300 ký tự):" Foreground="White"/>
          <TextBox Name="EditLabelBox" MaxLength="300" MinHeight="62" TextWrapping="Wrap"
                   AcceptsReturn="True" Margin="0,5,0,8"/>
          <TextBlock Text="Phân loại bằng chứng:" Foreground="White"/>
          <ComboBox Name="EditEvidenceBox" SelectedIndex="2" Margin="0,5,0,12">
            <ComboBoxItem Tag="visible-observation" Content="Quan sát trực tiếp trên ảnh"/>
            <ComboBoxItem Tag="hypothesis" Content="Giả thuyết (không phải bằng chứng đối thủ sẽ gank)"/>
            <ComboBoxItem Tag="uncertain" Content="Không xác định"/>
          </ComboBox>
          <WrapPanel>
            <Button Name="UpdateSampleButton" Content="Lưu sửa ghi chú" IsEnabled="False"
                    Click="UpdateSampleClick" Padding="12,8" Margin="0,0,8,8"
                    Background="#23705B" Foreground="White"/>
            <Button Name="DeleteSampleButton" Content="Xóa mẫu đang chọn" IsEnabled="False"
                    Click="DeleteSampleClick" Padding="12,8" Margin="0,0,8,8"
                    Background="#564236" Foreground="White"/>
          </WrapPanel>
        </StackPanel>
      </ScrollViewer>
    </Grid>
    <TextBlock Grid.Row="2" Name="LibraryStatus" Foreground="#8FE1C3"
               TextWrapping="Wrap" Margin="0,12,0,0"
               Text="Dữ liệu nằm trong thư mục mẫu V1.8 trên máy. Không tự gửi ảnh lên AI."/>
  </Grid>
</Window>
