<Window x:Class="XerathAssistant.Desktop.SelfStatsHudWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Xerath HUD · Own stats"
        Width="328" Height="173" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Focusable="False"
        Topmost="True" IsHitTestVisible="False"
        SourceInitialized="WindowSourceInitialized">
  <Border Background="#DD0B1521" CornerRadius="9" BorderBrush="#AA3D768F"
          BorderThickness="1" Padding="10">
    <StackPanel>
      <DockPanel LastChildFill="False" Margin="0,0,0,6">
        <TextBlock Text="XERATH · CHỈ SỐ CỦA BẠN" FontSize="11"
                   Foreground="#91C9E7" FontWeight="Bold" DockPanel.Dock="Left"/>
        <TextBlock Name="ClockText" Text="--:--" FontSize="12" Foreground="#C5D5E4"
                   DockPanel.Dock="Right"/>
      </DockPanel>
      <UniformGrid Columns="2">
        <TextBlock Name="HealthText" Text="HP: --" FontSize="13" FontWeight="SemiBold"
                   Foreground="#8DF1A8" Margin="0,0,7,3"/>
        <TextBlock Name="ManaText" Text="Mana: --" FontSize="13" FontWeight="SemiBold"
                   Foreground="#9FC9FF" Margin="0,0,0,3"/>
        <TextBlock Name="GoldText" Text="Vàng: --" FontSize="12" Foreground="#F5D386"
                   Margin="0,0,7,3"/>
        <TextBlock Name="LevelApText" Text="Lv -- · AP --" FontSize="12"
                   Foreground="#D5DFF2" Margin="0,0,0,3"/>
      </UniformGrid>
      <Border Name="AlertBorder" Background="#433A24" BorderBrush="#A68E53" BorderThickness="1"
              CornerRadius="5" Padding="6,4" Margin="0,4,0,2" Visibility="Collapsed">
        <TextBlock Name="AlertText" Text="" FontSize="11" FontWeight="SemiBold"
                   Foreground="#FFE3AA" TextWrapping="Wrap" MaxHeight="33"/>
      </Border>
      <TextBlock Name="StatusText" Text="Chờ dữ liệu của bạn trong trận..."
                 FontSize="10" Foreground="#A5B6C7" Margin="0,5,0,0"
                 TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
    </StackPanel>
  </Border>
</Window>
