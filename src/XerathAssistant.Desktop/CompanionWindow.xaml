<Window x:Class="XerathAssistant.Desktop.CompanionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Xerath Support Assistant · Companion V1.2 · Giọng cảnh báo HUD" Width="980" Height="760"
        MinWidth="720" MinHeight="600" Background="#0B1521" FontFamily="Segoe UI">
  <Window.Resources>
    <Style x:Key="CompanionSectionTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="17"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="Margin" Value="0,0,0,7"/>
    </Style>
    <Style x:Key="CompanionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Margin" Value="0,0,8,8"/>
      <Setter Property="MinHeight" Value="35"/>
      <Style.Triggers>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Background" Value="#344052"/>
          <Setter Property="Foreground" Value="#A8B6C6"/>
          <Setter Property="Opacity" Value="0.48"/>
          <Setter Property="Cursor" Value="Arrow"/>
        </Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="18">
      <StackPanel MaxWidth="1020" HorizontalAlignment="Center">
        <TextBlock Text="XERATH · SUPPORT ASSISTANT" FontSize="24" FontWeight="Bold"/>
        <TextBlock Margin="0,4,0,14" Foreground="{StaticResource MutedBrush}"
                   Text="Trợ lý đi cùng Liên Minh · Lời nhắc tùy chọn và bảng chỉ số cá nhân · Không điều khiển game."/>

        <Border Background="#122339" CornerRadius="10" Padding="14" Margin="0,0,0,10">
          <StackPanel>
            <TextBlock Name="GameStatus" Text="Đang kiểm tra trò chơi..." FontWeight="SemiBold" FontSize="15"/>
            <TextBlock Margin="0,4,0,0" Foreground="{StaticResource MutedBrush}" FontSize="12"
                       Text="Chỉ phát hiện tiến trình Windows. Chế độ nhắc không tự đọc thế lính hay vị trí đối thủ."/>
          </StackPanel>
        </Border>

        <Border Background="#122339" CornerRadius="10" Padding="14" Margin="0,0,0,10">
          <StackPanel>
            <TextBlock Style="{StaticResource CompanionSectionTitle}" Text="1 · Lịch nhắc việc Xerath SP"/>
            <TextBlock Margin="0,0,0,8" Foreground="{StaticResource MutedBrush}" FontSize="12"
                       Text="Các lời nhắc bên dưới chạy theo thời gian, không phải cảnh báo tình huống thực tế."/>
            <UniformGrid Columns="2">
              <CheckBox Name="MapCheck" IsChecked="True" Margin="0,0,12,8"
                        Content="Minimap — kiểm tra bản đồ mỗi 45 giây"/>
              <CheckBox Name="VisionCheck" IsChecked="True" Margin="0,0,12,8"
                        Content="Tầm nhìn — kiểm tra mắt, sông và máy quét mỗi 3 phút"/>
              <CheckBox Name="JungleCheck" IsChecked="True" Margin="0,0,12,8"
                        Content="Rừng đồng minh — nhớ nhìn minimap mỗi 90 giây"/>
              <CheckBox Name="AdcCheck" IsChecked="True" Margin="0,0,12,8"
                        Content="ADC — kiểm tra vị trí xạ thủ mỗi 2 phút"/>
              <CheckBox Name="ManaCheck" IsChecked="True" Margin="0,0,12,8"
                        Content="Xerath — kiểm tra năng lượng và vị trí đứng mỗi 2 phút 30 giây"/>
              <CheckBox Name="ObjectiveCheck" IsChecked="True" Margin="0,0,12,8"
                        Content="Mục tiêu lớn — kiểm tra đồng hồ và tầm nhìn mỗi 3 phút"/>
            </UniformGrid>
          </StackPanel>
        </Border>

        <Border Background="#122339" CornerRadius="10" Padding="14" Margin="0,0,0,10">
          <StackPanel>
            <TextBlock Style="{StaticResource CompanionSectionTitle}" Text="2 · Giọng nói tiếng Việt (tùy chọn)"/>
            <CheckBox Name="VoiceCheck" IsChecked="True" Margin="0,0,0,5"
                      Content="Giọng đọc tiếng Việt miễn phí (âm lượng 70%)"/>
            <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,9"
                       Text="Tạo trước tiếng Việt cho cả lời nhắc theo giờ và 7 cảnh báo HUD (máu thấp, máu giảm nhanh, hạ gục, hồi sinh...). Khi chơi, HUD chỉ phát tệp đã lưu, không gọi dịch vụ tạo giọng. Nếu dịch vụ trực tuyến lỗi, có thể dùng eSpeak NG miễn phí."/>
            <WrapPanel>
              <Button Name="PrepareVoiceButton" Style="{StaticResource CompanionButton}" Click="PrepareVoiceClick"
                      Background="#23705B" Content="Tạo giọng tiếng Việt miễn phí"/>
              <Button Name="TestVoiceButton" Style="{StaticResource CompanionButton}" Click="TestVoiceClick"
                      Content="Nghe thử" IsEnabled="False"/>
            </WrapPanel>
            <TextBlock Name="VoiceStatus" Foreground="{StaticResource MutedBrush}" FontSize="12"
                       Text="Bấm Tạo giọng tiếng Việt miễn phí rồi Nghe thử. Muốn HUD tự phát lời khi có sự kiện, bật giọng trong mục Chỉ số trực tiếp: KHÔNG cần nhấn Bắt đầu nhắc. Bắt đầu nhắc chỉ dành cho bộ hẹn giờ."/>
          </StackPanel>
        </Border>

        <Border Background="#122339" CornerRadius="10" Padding="14" Margin="0,0,0,10">
          <StackPanel>
            <TextBlock Style="{StaticResource CompanionSectionTitle}" Text="3 · Điều khiển phiên nhắc"/>
            <WrapPanel>
              <Button Name="StartButton" Style="{StaticResource CompanionButton}" Click="StartClick"
                      Content="Bắt đầu nhắc" Background="#23705B"/>
              <Button Name="PauseButton" Style="{StaticResource CompanionButton}" Click="PauseClick"
                      Content="Tạm dừng" IsEnabled="False"/>
              <Button Name="StopButton" Style="{StaticResource CompanionButton}" Click="StopClick"
                      Content="Kết thúc" IsEnabled="False"/>
            </WrapPanel>
            <TextBlock Margin="0,0,0,7" FontSize="12" Foreground="{StaticResource MutedBrush}"
                       Text="Tạm dừng và Kết thúc chỉ bật sau khi phiên nhắc đã bắt đầu."/>
            <TextBlock Name="SessionStatus" Text="Chưa bắt đầu phiên chơi."/>
            <TextBlock Name="LastReminder" Margin="0,6,0,0" Foreground="#8FE1C3"
                       Text="Lời nhắc gần nhất: chưa có."/>
          </StackPanel>
        </Border>

        <Border Background="#122339" CornerRadius="10" Padding="14" Margin="0,0,0,10">
          <StackPanel>
            <TextBlock Style="{StaticResource CompanionSectionTitle}" Text="4 · Công cụ bổ sung"/>
            <WrapPanel>
              <Button Style="{StaticResource CompanionButton}" Click="OpenHudClick"
                      Background="#23705B" Content="Bật HUD theo tình huống trong game"/>
              <Button Style="{StaticResource CompanionButton}" Click="OpenSelfStatsClick"
                      Content="Chỉ số trực tiếp &amp; tổng hợp · tùy chỉnh HUD"/>
              <Button Style="{StaticResource CompanionButton}" Click="OpenLabClick" Content="Mở Aim Lab V0.1"/>
              <Button Style="{StaticResource CompanionButton}" Click="OpenLastSeenReviewClick"
                      Content="Xem lại vị trí rừng địch"/>
              <Button Style="{StaticResource CompanionButton}" Click="OpenWaveFightAdvisorClick"
                      Content="Phân tích thế lính &amp; giao tranh"/>
            </WrapPanel>
            <TextBlock FontSize="12" Foreground="{StaticResource MutedBrush}"
                       Text="HUD ưu tiên trạng thái bị hạ gục, hồi sinh và biến động máu thực; có thể phát tiếng Việt đã tạo sẵn và hiện chữ ngay trong game. Chọn bật giọng, nghe thử hoặc thử kết nối AI cá nhân trong Chỉ số trực tiếp. Chưa có AI đọc màn hình hay theo dõi rừng địch."/>
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>
  </ScrollViewer>
</Window>
