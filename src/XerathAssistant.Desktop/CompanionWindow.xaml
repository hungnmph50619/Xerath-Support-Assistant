<Window x:Class="XerathAssistant.Desktop.CompanionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Xerath Support Assistant · Companion V0.2" Width="780" Height="650"
        MinWidth="700" MinHeight="570" Background="#0B1521" FontFamily="Segoe UI">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="23">
      <TextBlock Text="XERATH · SUPPORT ASSISTANT" FontSize="25" FontWeight="Bold"/>
      <TextBlock Margin="0,5,0,15" Foreground="{StaticResource MutedBrush}"
                 Text="Chạy song song với Liên Minh Huyền Thoại · Nhắc việc bằng giọng nói, không điều khiển game."/>
      <Border Background="#122339" CornerRadius="10" Padding="15" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Name="GameStatus" Text="Đang kiểm tra trò chơi..." FontWeight="SemiBold" FontSize="15"/>
          <TextBlock Margin="0,6,0,0" Foreground="{StaticResource MutedBrush}"
                     Text="Mở game, vào trận rồi nhấn Bắt đầu. Công cụ chỉ kiểm tra tên tiến trình Windows; không đọc dữ liệu trận đấu."/>
        </StackPanel>
      </Border>
      <Border Background="#122339" CornerRadius="10" Padding="15" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock FontWeight="SemiBold" FontSize="17" Text="Lịch nhắc việc Xerath SP"/>
          <TextBlock Margin="0,5,0,10" Foreground="{StaticResource MutedBrush}"
                     Text="Chọn nhóm nhắc trước khi bắt đầu. Các mốc dưới đây là bộ hẹn giờ độc lập, KHÔNG phải cảnh báo theo tình huống thực tế."/>
          <CheckBox Name="MapCheck" IsChecked="True" Margin="0,0,0,7" Content="Minimap — kiểm tra bản đồ mỗi 45 giây"/>
          <CheckBox Name="VisionCheck" IsChecked="True" Margin="0,0,0,7" Content="Tầm nhìn — kiểm tra mắt, sông và máy quét mỗi 3 phút"/>
          <CheckBox Name="JungleCheck" IsChecked="True" Margin="0,0,0,7" Content="Rừng đồng minh — nhớ nhìn minimap mỗi 90 giây"/>
          <CheckBox Name="AdcCheck" IsChecked="True" Margin="0,0,0,7" Content="ADC — kiểm tra vị trí xạ thủ mỗi 2 phút"/>
          <CheckBox Name="ManaCheck" IsChecked="True" Margin="0,0,0,7" Content="Xerath — kiểm tra năng lượng và vị trí đứng mỗi 2 phút 30 giây"/>
          <CheckBox Name="ObjectiveCheck" IsChecked="True" Margin="0,0,0,7" Content="Mục tiêu lớn — kiểm tra đồng hồ và tầm nhìn mỗi 3 phút"/>
          <CheckBox Name="VoiceCheck" IsChecked="True" Margin="0,8,0,0"
                    Content="Đọc lời nhắc bằng giọng nói Windows (âm lượng 70%)"/>
          <TextBlock Name="VoiceStatus" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"
                     Text="Hệ thống tự kiểm tra giọng đọc tiếng Việt trên Windows."/>
        </StackPanel>
      </Border>
      <Border Background="#122339" CornerRadius="10" Padding="15" Margin="0,0,0,12">
        <StackPanel>
          <WrapPanel>
            <Button Name="StartButton" Click="StartClick" Content="Bắt đầu nhắc" Background="#23705B"/>
            <Button Name="PauseButton" Click="PauseClick" Content="Tạm dừng" IsEnabled="False"/>
            <Button Name="StopButton" Click="StopClick" Content="Kết thúc" IsEnabled="False"/>
            <Button Click="OpenLabClick" Content="Mở Aim Lab V0.1"/>
          </WrapPanel>
          <TextBlock Name="SessionStatus" Margin="0,12,0,0" Text="Chưa bắt đầu phiên chơi."/>
          <TextBlock Name="LastReminder" Margin="0,8,0,0" Foreground="#8FE1C3"
                     Text="Lời nhắc gần nhất: chưa có."/>
        </StackPanel>
      </Border>
      <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="12"
                 Text="V0.2 không chụp màn hình, không đọc minimap, không tự nhận diện gank Near/Arrived hay hỗ trợ ngắm chiêu trong trận. Chế độ luyện ngắm V0.1 vẫn mở riêng qua nút Aim Lab."/>
    </StackPanel>
  </ScrollViewer>
</Window>
