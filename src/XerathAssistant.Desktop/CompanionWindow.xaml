<Window x:Class="XerathAssistant.Desktop.CompanionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Xerath Support Assistant · Trợ lý trận đấu" Width="920" Height="660"
        MinWidth="720" MinHeight="600" Background="#0B1521" FontFamily="Segoe UI">
  <Window.Resources>
    <Style x:Key="CompanionSectionTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="17"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="Margin" Value="0,0,0,7"/>
    </Style>
    <Style x:Key="CompanionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Margin" Value="0,0,8,8"/>
      <Setter Property="MinHeight" Value="35"/>
      <Style.Triggers>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Background" Value="#344052"/>
          <Setter Property="Foreground" Value="#A8B6C6"/>
          <Setter Property="Opacity" Value="0.48"/>
          <Setter Property="Cursor" Value="Arrow"/>
        </Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="18">
      <StackPanel MaxWidth="1020" HorizontalAlignment="Center">
        <TextBlock Text="XERATH · SUPPORT ASSISTANT" FontSize="24" FontWeight="Bold"/>
        <TextBlock Margin="0,4,0,14" Foreground="{StaticResource MutedBrush}"
                   Text="Hai việc chính: cảnh báo theo máu và thu ảnh minimap có chọn lọc. Không điều khiển game."/>

        <Border Background="#122339" CornerRadius="10" Padding="14" Margin="0,0,0,10">
          <StackPanel>
            <TextBlock Name="GameStatus" Text="Đang kiểm tra trò chơi..." FontWeight="SemiBold" FontSize="15"/>
            <TextBlock Margin="0,4,0,0" Foreground="{StaticResource MutedBrush}" FontSize="12"
                       Text="Chỉ phát hiện tiến trình Windows. Chế độ nhắc không tự đọc thế lính hay vị trí đối thủ."/>
          </StackPanel>
        </Border>

        <Border Background="#172D3D" CornerRadius="12" Padding="19" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock Text="CẢNH BÁO TRONG TRẬN" Foreground="#8FE1C3" FontSize="13" FontWeight="Bold"/>
            <TextBlock Text="Theo dõi máu của bạn và cảnh báo nguy hiểm" FontSize="19"
                       FontWeight="SemiBold" Margin="0,5,0,6"/>
            <TextBlock Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                       Margin="0,0,0,12" Text="Dựa trên chỉ số máu đã quan sát, không dự đoán Rừng/Mid hoặc gank."/>
            <WrapPanel>
              <Button Style="{StaticResource CompanionButton}" Click="OpenHudClick"
                      Background="#23705B" Padding="15,11" Content="Bật HUD cảnh báo"/>
              <Button Style="{StaticResource CompanionButton}" Click="OpenSelfStatsClick"
                      Padding="15,11" Content="Xem chỉ số &amp; cài đặt HUD"/>
            </WrapPanel>
          </StackPanel>
        </Border>
        <Border Background="#172D3D" CornerRadius="12" Padding="19" Margin="0,0,0,14">
          <StackPanel>
            <TextBlock Text="MINIMAP · THU DỮ LIỆU" Foreground="#A9D5FC" FontSize="13" FontWeight="Bold"/>
            <TextBlock Text="Xem minimap và chọn ảnh để AI học sau này" FontSize="19"
                       FontWeight="SemiBold" Margin="0,5,0,6"/>
            <TextBlock Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                       Margin="0,0,0,12" Text="Xem trước và thu tối đa 5 ảnh trong RAM; không cần Gemini, không tự lưu ảnh."/>
            <Button Style="{StaticResource CompanionButton}" Click="OpenMinimapTrainingClick"
                    Background="#315F84" Padding="15,11" HorizontalAlignment="Left"
                    Content="Mở minimap · Xem trước &amp; thu ảnh"/>
          </StackPanel>
        </Border>
        <Expander Header="Âm thanh tiếng Việt · mở khi cần tạo hoặc nghe thử" IsExpanded="False" Foreground="#EAF2FC" Background="#14263A" Padding="8" Margin="0,0,0,9">
          <StackPanel>        <Border Background="#122339" CornerRadius="10" Padding="14" Margin="0,0,0,10">
          <StackPanel>
            <TextBlock Style="{StaticResource CompanionSectionTitle}" Text="Giọng nói tiếng Việt"/>
            <CheckBox Name="VoiceCheck" IsChecked="True" Margin="0,0,0,5"
                      Content="Giọng đọc tiếng Việt miễn phí (âm lượng 70%)"/>
            <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,9"
                       Text="Tạo trước tiếng Việt cho cả lời nhắc theo giờ và 10 câu cảnh báo HUD, gồm ba mức nguy hiểm dựa trên máu thực, máu thấp, hạ gục và hồi sinh. Khi chơi, HUD chỉ phát tệp đã lưu, không gọi dịch vụ tạo giọng. Nếu dịch vụ trực tuyến lỗi, có thể dùng eSpeak NG miễn phí."/>
            <WrapPanel>
              <Button Name="PrepareVoiceButton" Style="{StaticResource CompanionButton}" Click="PrepareVoiceClick"
                      Background="#23705B" Content="Tạo giọng tiếng Việt miễn phí"/>
              <Button Name="TestVoiceButton" Style="{StaticResource CompanionButton}" Click="TestVoiceClick"
                      Content="Nghe thử" IsEnabled="False"/>
            </WrapPanel>
            <TextBlock Name="VoiceStatus" Foreground="{StaticResource MutedBrush}" FontSize="12"
                       Text="Bấm Tạo giọng tiếng Việt miễn phí rồi Nghe thử. Muốn HUD tự phát lời khi có sự kiện, bật giọng trong mục Chỉ số trực tiếp: KHÔNG cần nhấn Bắt đầu nhắc. Bắt đầu nhắc chỉ dành cho bộ hẹn giờ."/>
          </StackPanel>
        </Border>


          </StackPanel>
        </Expander>
        <Expander Header="Lời nhắc theo giờ · tùy chọn, mặc định tắt" IsExpanded="False" Foreground="#EAF2FC" Background="#14263A" Padding="8" Margin="0,0,0,9">
          <StackPanel>        <Border Background="#122339" CornerRadius="10" Padding="14" Margin="0,0,0,10">
          <StackPanel>
            <TextBlock Style="{StaticResource CompanionSectionTitle}" Text="Lời nhắc theo giờ (mặc định tắt)"/>
            <TextBlock Margin="0,0,0,8" Foreground="{StaticResource MutedBrush}" FontSize="12"
                       Text="Các lời nhắc theo giờ mặc định tắt để tránh đọc lặp. Chỉ tích loại bạn muốn rồi nhấn Bắt đầu nhắc; cảnh báo nguy hiểm theo máu trên HUD chạy riêng."/>
            <UniformGrid Columns="2">
              <CheckBox Name="MapCheck" IsChecked="False" Margin="0,0,12,8"
                        Content="Minimap — kiểm tra bản đồ mỗi 45 giây"/>
              <CheckBox Name="VisionCheck" IsChecked="False" Margin="0,0,12,8"
                        Content="Tầm nhìn — kiểm tra mắt, sông và máy quét mỗi 3 phút"/>
              <CheckBox Name="JungleCheck" IsChecked="False" Margin="0,0,12,8"
                        Content="Rừng đồng minh — nhớ nhìn minimap mỗi 90 giây"/>
              <CheckBox Name="AdcCheck" IsChecked="False" Margin="0,0,12,8"
                        Content="ADC — kiểm tra vị trí xạ thủ mỗi 2 phút"/>
              <CheckBox Name="ManaCheck" IsChecked="False" Margin="0,0,12,8"
                        Content="Xerath — kiểm tra năng lượng và vị trí đứng mỗi 2 phút 30 giây"/>
              <CheckBox Name="ObjectiveCheck" IsChecked="False" Margin="0,0,12,8"
                        Content="Mục tiêu lớn — kiểm tra đồng hồ và tầm nhìn mỗi 3 phút"/>
            </UniformGrid>
          </StackPanel>
        </Border>

        <Border Background="#122339" CornerRadius="10" Padding="14" Margin="0,0,0,10">
          <StackPanel>
            <TextBlock Style="{StaticResource CompanionSectionTitle}" Text="Điều khiển lời nhắc theo giờ"/>
            <WrapPanel>
              <Button Name="StartButton" Style="{StaticResource CompanionButton}" Click="StartClick"
                      Content="Bắt đầu nhắc" Background="#23705B"/>
              <Button Name="PauseButton" Style="{StaticResource CompanionButton}" Click="PauseClick"
                      Content="Tạm dừng" IsEnabled="False"/>
              <Button Name="StopButton" Style="{StaticResource CompanionButton}" Click="StopClick"
                      Content="Kết thúc" IsEnabled="False"/>
            </WrapPanel>
            <TextBlock Margin="0,0,0,7" FontSize="12" Foreground="{StaticResource MutedBrush}"
                       Text="Tạm dừng và Kết thúc chỉ bật sau khi phiên nhắc đã bắt đầu."/>
            <TextBlock Name="SessionStatus" Text="Chưa bắt đầu phiên chơi."/>
            <TextBlock Name="LastReminder" Margin="0,6,0,0" Foreground="#8FE1C3"
                       Text="Lời nhắc gần nhất: chưa có."/>
          </StackPanel>
        </Border>


          </StackPanel>
        </Expander>
        <Expander Header="Công cụ thử nghiệm khác" IsExpanded="False" Foreground="#EAF2FC" Background="#14263A" Padding="8" Margin="0,0,0,9">
          <StackPanel>        <Border Background="#122339" CornerRadius="10" Padding="14" Margin="0,0,0,10">
          <StackPanel>
            <TextBlock Style="{StaticResource CompanionSectionTitle}" Text="Công cụ thử nghiệm khác"/>
            <WrapPanel>
              <Button Style="{StaticResource CompanionButton}" Click="OpenLabClick" Content="Mở Aim Lab V0.1"/>
              <Button Style="{StaticResource CompanionButton}" Click="OpenLastSeenReviewClick"
                      Content="Xem lại vị trí Rừng / Mid · nghe tiếng Việt"/>
              <Button Style="{StaticResource CompanionButton}" Click="OpenWaveFightAdvisorClick"
                      Content="Phân tích thế lính &amp; giao tranh"/>
            </WrapPanel>
          </StackPanel>
        </Border>

          </StackPanel>
        </Expander>
      </StackPanel>
    </Grid>
  </ScrollViewer>
</Window>
