<Window x:Class="XerathAssistant.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Xerath Support Assistant · Aim Lab V0.1" Width="1150" Height="800"
        MinWidth="990" MinHeight="700" Background="#0B1521" FontFamily="Segoe UI">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="23">
      <TextBlock FontSize="27" FontWeight="Bold" Text="XERATH · AIM LAB"/>
      <TextBlock Margin="0,5,0,15" Foreground="{StaticResource MutedBrush}"
                 Text="Prototype luyện ngắm Q / W / E / R. Không đọc màn hình game, không can thiệp client, không điều khiển chuột."/>
      <Border CornerRadius="10" Background="#122339" Padding="13" Margin="0,0,0,12">
        <WrapPanel VerticalAlignment="Center">
          <TextBlock VerticalAlignment="Center" Text="Kỹ năng" Margin="0,0,10,0"/>
          <ComboBox Name="SpellPicker" Width="125" SelectionChanged="SettingsChanged">
            <ComboBoxItem Content="Q" IsSelected="True"/><ComboBoxItem Content="W"/>
            <ComboBoxItem Content="E"/><ComboBoxItem Content="R"/>
          </ComboBox>
          <TextBlock Margin="19,0,10,0" VerticalAlignment="Center" Text="Q đã vận"/>
          <Slider Name="ChargeSlider" Width="110" Minimum="0" Maximum="1.5" Value="1.5" TickFrequency="0.1"
                  ValueChanged="SettingsChanged" VerticalAlignment="Center"/>
          <TextBlock Name="ChargeLabel" Width="40" VerticalAlignment="Center" Margin="7,0,0,0" Text="1.5 s"/>
          <TextBlock Margin="15,0,10,0" VerticalAlignment="Center" Text="Tốc độ mục tiêu"/>
          <Slider Name="SpeedSlider" Width="95" Minimum="20" Maximum="210" Value="90" ValueChanged="SettingsChanged"/>
          <TextBlock Name="SpeedLabel" Width="55" VerticalAlignment="Center" Margin="7,0,0,0" Text="90 px/s"/>
          <CheckBox Name="ZigzagCheck" VerticalAlignment="Center" Margin="12,0,0,0" Content="Đổi hướng" Checked="SettingsChanged" Unchecked="SettingsChanged"/>
          <CheckBox Name="BlockerCheck" VerticalAlignment="Center" Margin="12,0,0,0" Content="Lính chắn E" Checked="SettingsChanged" Unchecked="SettingsChanged"/>
        </WrapPanel>
      </Border>
      <Border CornerRadius="10" BorderBrush="#284963" BorderThickness="1" Background="#101D2C" Padding="8">
        <Canvas Name="Arena" Width="1010" Height="465" Background="#101D2C"
                MouseLeftButtonDown="ArenaMouseDown" MouseLeftButtonUp="ArenaMouseUp" MouseMove="ArenaMouseMove"/>
      </Border>
      <Border CornerRadius="10" Background="#122339" Padding="15" Margin="0,13,0,0">
        <StackPanel>
          <WrapPanel>
            <Button Name="CastButton" Width="132" Click="CastClick" Background="#23705B" Content="Thử tung chiêu"/>
            <Button Width="120" Click="PauseClick" Name="PauseButton" Content="Tạm dừng"/>
            <Button Width="120" Click="ResetClick" Content="Đặt lại"/>
            <TextBlock Name="ScoreLabel" Margin="12,8,0,0" FontWeight="SemiBold" Text="Trúng: 0 | Trượt: 0"/>
          </WrapPanel>
          <TextBlock Name="PredictionLabel" Margin="0,13,0,0" FontSize="14" Text="Đang khởi tạo..."/>
          <TextBlock Name="FeedbackLabel" Margin="0,6,0,0" Foreground="#8FE1C3"
                     Text="Bấm 'Thử tung chiêu' để so sánh điểm ngắm dự đoán với vị trí mục tiêu khi chiêu tác dụng."/>
          <TextBlock Margin="0,10,0,0" Foreground="{StaticResource MutedBrush}" FontSize="12"
                     Text="Kéo chấm đỏ để đổi vị trí mục tiêu; có thể bật mục tiêu đổi hướng và lính chắn E. Các tầm, bán kính và độ trễ là thông số MÔ PHỎNG, không phải chỉ số LoL thực tế."/>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</Window>
