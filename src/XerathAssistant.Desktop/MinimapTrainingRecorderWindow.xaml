<Window x:Class="XerathAssistant.Desktop.MinimapTrainingRecorderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mắt nhìn AI · Thu ảnh minimap" Width="1040" Height="715"
        MinWidth="890" MinHeight="580" WindowStartupLocation="CenterScreen"
        Background="#0D1724" FontFamily="Segoe UI" Foreground="#ECF4FC">
  <Window.Resources>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="#ECF4FC"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="12,8"/>
      <Setter Property="MinHeight" Value="38"/>
      <Setter Property="Margin" Value="0,0,9,9"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Background" Value="#294763"/>
      <Setter Property="Foreground" Value="White"/>
      <Style.Triggers>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Background" Value="#344052"/>
          <Setter Property="Foreground" Value="#BAC7D6"/>
          <Setter Property="Cursor" Value="Arrow"/>
          <Setter Property="Opacity" Value="0.7"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="White"/>
      <Setter Property="Foreground" Value="#162335"/>
      <Setter Property="Padding" Value="7,5"/>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Background" Value="White"/>
      <Setter Property="Foreground" Value="#162335"/>
      <Setter Property="MinHeight" Value="34"/>
      <Setter Property="Padding" Value="6,4"/>
    </Style>
    <Style TargetType="TabItem">
      <Setter Property="Background" Value="#233C52"/>
      <Setter Property="Foreground" Value="#F0F5FD"/>
      <Setter Property="Padding" Value="14,9"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="#325A78"/>
          <Setter Property="Foreground" Value="White"/>
        </Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>
  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Margin="0,0,0,12">
      <TextBlock Text="MẮT NHÌN AI · MINIMAP" FontSize="21" FontWeight="Bold"/>
      <TextBlock Text="Xem trước → Thu ảnh → Chọn ảnh cần lưu. Không gửi Gemini nếu bạn không bật chế độ AI riêng."
                 Foreground="#BED2E7" FontSize="12" Margin="0,4,0,0"/>
    </StackPanel>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="390"/>
        <ColumnDefinition Width="12"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" CornerRadius="10" Padding="11" Background="#15283B">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Text="ẢNH MINIMAP ĐANG XEM" FontWeight="Bold"
                     Margin="0,0,0,8" FontSize="14"/>
          <Border Grid.Row="1" Background="#090F17" CornerRadius="7"
                  BorderBrush="#34516A" BorderThickness="1" MinHeight="250">
            <Grid>
              <TextBlock Name="PreviewEmptyText"
                         Text="Chưa có ảnh. Bấm Tự tìm minimap, chuyển về trận rồi quay lại kiểm tra."
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         TextAlignment="Center" MaxWidth="290" Foreground="#AFC3DA"/>
              <Image Name="SamplePreview" Stretch="Uniform" HorizontalAlignment="Stretch"
                     VerticalAlignment="Stretch" Cursor="Cross"
                     MouseLeftButtonDown="SamplePreviewClick"/>
            </Grid>
          </Border>
          <TextBlock Grid.Row="2" Name="MarkCoordinateStatus" Foreground="#8FE1C3"
                     Text="Nhấp vào biểu tượng tướng nhìn thấy để chọn tọa độ."
                     FontSize="12" Margin="0,8,0,5"/>
          <TextBlock Grid.Row="3" Foreground="#F9CF90" FontSize="12"
                     Text="Ảnh chỉ ở RAM, trừ khi bạn chủ động chọn lưu. Không đánh dấu tướng khuất tầm nhìn."/>
        </Grid>
      </Border>
      <TabControl Grid.Column="2" Name="WorkflowTabs" SelectedIndex="0"
                  Background="#15283B" BorderThickness="0">
        <TabItem Header="Thu ảnh">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="12" MaxWidth="650">
              <TextBlock Text="1 · Tự tìm minimap" FontSize="17" FontWeight="Bold"
                         Margin="0,0,0,5"/>
              <TextBlock Foreground="#CADDED" FontSize="12" Margin="0,0,0,10"
                         Text="Bấm Tự tìm minimap → chuyển về trận → kiểm tra ảnh bên trái. Nếu khung đúng, bấm Dùng khung này. Chỉ mở Chỉnh tay khi ảnh bị lệch. Việc tìm khung chạy cục bộ, không gửi Gemini."/>
              <WrapPanel>
                <Button Name="AutoDetectButton" Click="AutoDetectMinimapClick"
                        Content="Tự tìm minimap" Background="#315F84"/>
                <Button Name="PreviewCropButton" Click="PreviewCropClick"
                        Content="Xem trước lại" ToolTip="Dùng vùng đã lưu hoặc vùng chỉnh tay hiện tại"/>
                <Button Name="SaveCropButton" Click="SaveCropClick" IsEnabled="False"
                        Content="Dùng khung này" Background="#23705B"/>
              </WrapPanel>
              <TextBlock Name="CropStatusText" Foreground="#8FE1C3" FontSize="12"
                         Text="Chưa có ảnh minimap. Bấm Tự tìm minimap để bắt đầu." Margin="0,1,0,8"/>
              <Expander Name="ManualCropExpander" Header="Ảnh bị lệch? Chỉnh tay nếu cần" IsExpanded="False"
                        Foreground="#E8F0F9" Margin="0,0,0,10">
                <StackPanel Margin="8,8,0,4">
                  <TextBlock Foreground="#B9CCDF" FontSize="12" Margin="0,0,0,7"
                             Text="Chỉ chỉnh các mép khi ảnh bên trái bị thiếu hoặc thừa vùng ngoài minimap. Sau đó bấm Xem trước lại và kiểm tra ảnh trước khi xác nhận."/>
                  <UniformGrid Columns="2">
                    <StackPanel Margin="0,0,14,6">
                      <TextBlock Text="Mép trái (%)"/>
                      <Slider Name="CropLeftSlider" ValueChanged="CropSliderChanged"
                              Minimum="0" Maximum="90" Value="78" TickFrequency="0.1"
                              IsSnapToTickEnabled="False" AutoToolTipPlacement="TopLeft" Margin="0,2,0,9"/>
                      <TextBlock Text="Chiều rộng (%)"/>
                      <Slider Name="CropWidthSlider" ValueChanged="CropSliderChanged"
                              Minimum="8" Maximum="50" Value="22" TickFrequency="0.1"
                              IsSnapToTickEnabled="False" AutoToolTipPlacement="TopLeft" Margin="0,2,0,7"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,6,6">
                      <TextBlock Text="Mép trên (%)"/>
                      <Slider Name="CropTopSlider" ValueChanged="CropSliderChanged"
                              Minimum="0" Maximum="90" Value="70" TickFrequency="0.1"
                              IsSnapToTickEnabled="False" AutoToolTipPlacement="TopLeft" Margin="0,2,0,9"/>
                      <TextBlock Text="Chiều cao (%)"/>
                      <Slider Name="CropHeightSlider" ValueChanged="CropSliderChanged"
                              Minimum="8" Maximum="50" Value="30" TickFrequency="0.1"
                              IsSnapToTickEnabled="False" AutoToolTipPlacement="TopLeft" Margin="0,2,0,7"/>
                    </StackPanel>
                  </UniformGrid>
                </StackPanel>
              </Expander>
              <Border Background="#304657" Height="1" Margin="0,2,0,12"/>
              <TextBlock Text="2 · Thu 5 ảnh trong RAM" FontSize="17" FontWeight="Bold"
                         Margin="0,0,0,5"/>
              <TextBlock Foreground="#CADDED" FontSize="12" Margin="0,0,0,10"
                         Text="Không cần Gemini. Nhấn Thu, chuyển về game khoảng 10–15 giây rồi quay lại chọn ảnh để xem."/>
              <WrapPanel>
                <Button Name="SequenceStartButton" Click="StartSequenceClick"
                        Content="Thu 5 ảnh" Background="#23705B"/>
                <Button Name="SequenceClearButton" Click="ClearSequenceClick"
                        Content="Xóa ảnh tạm trong RAM"/>
              </WrapPanel>
              <ComboBox Name="SequenceFrameBox" SelectionChanged="SequenceFrameChanged"
                        Margin="0,0,0,6" MinWidth="250"/>
              <TextBlock Name="SequenceStatus" Foreground="#8FE1C3" FontSize="12"
                         Text="Chưa có chuỗi ảnh. Hãy kiểm tra và lưu khung trước khi thu."/>
              <Button Click="GoToLabelClick" Content="Chọn ảnh xong → Gắn nhãn hoặc mở thư viện"
                      HorizontalAlignment="Left" Margin="0,14,0,0"/>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
        <TabItem Header="Gắn nhãn &amp; thư viện">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="12" MaxWidth="650">
              <TextBlock Text="Chỉ lưu ảnh bạn chọn" FontSize="18" FontWeight="Bold"/>
              <TextBlock Foreground="#CADDED" FontSize="12" Margin="0,5,0,13"
                         Text="Chọn khung ở thẻ Thu ảnh, rồi nhấp biểu tượng trên ảnh bên trái nếu muốn gắn tọa độ. Không cần gắn điểm khi ảnh mờ hoặc chưa rõ tướng."/>
              <Expander Header="Gắn tọa độ tướng (tùy chọn)" IsExpanded="False"
                        Foreground="#E8F0F9" Margin="0,0,0,10">
                <StackPanel Margin="8,8,0,0">
                  <TextBox Name="ChampionNameBox" MaxLength="50" Margin="0,0,0,8"
                           ToolTip="Tên tướng thực sự nhìn thấy được"/>
                  <WrapPanel>
                    <ComboBox Name="ChampionTeamBox" Width="150" SelectedIndex="2" Margin="0,0,8,8">
                      <ComboBoxItem Content="Đồng minh" Tag="ally"/>
                      <ComboBoxItem Content="Đối thủ" Tag="enemy"/>
                      <ComboBoxItem Content="Chưa rõ đội" Tag="unknown"/>
                    </ComboBox>
                    <ComboBox Name="ChampionRoleBox" Width="155" SelectedIndex="5" Margin="0,0,8,8">
                      <ComboBoxItem Content="Top" Tag="top"/>
                      <ComboBoxItem Content="Rừng" Tag="jungle"/>
                      <ComboBoxItem Content="Mid" Tag="mid"/>
                      <ComboBoxItem Content="Bot/ADC" Tag="bottom"/>
                      <ComboBoxItem Content="Support" Tag="support"/>
                      <ComboBoxItem Content="Chưa rõ vai trò" Tag="unknown"/>
                    </ComboBox>
                    <Button Click="AddChampionMarkClick" Content="Thêm điểm"/>
                    <Button Click="ClearChampionMarksClick" Content="Xóa điểm"/>
                  </WrapPanel>
                  <TextBlock Name="ChampionMarksStatus" Text="Chưa có điểm đánh dấu."
                             Foreground="#AFC3D8" FontSize="12"/>
                </StackPanel>
              </Expander>
              <TextBlock Text="Bạn nhìn thấy gì trong ảnh?" FontWeight="SemiBold" Margin="0,0,0,6"/>
              <ComboBox Name="EvidenceTypeBox" SelectedIndex="2" Margin="0,0,0,9">
                <ComboBoxItem Tag="visible-observation" Content="Quan sát trực tiếp"/>
                <ComboBoxItem Tag="hypothesis" Content="Giả thuyết, chưa xác minh"/>
                <ComboBoxItem Tag="uncertain" Content="Chưa rõ / không xác định"/>
              </ComboBox>
              <TextBox Name="SampleLabelBox" MinHeight="70" MaxLength="300"
                       TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,9"/>
              <Button Name="SaveSampleButton" IsEnabled="False" Click="SaveSampleClick"
                      Content="Lưu ảnh này cùng ghi chú" Background="#23705B"/>
              <TextBlock Name="TrainingStatus" Foreground="#8FE1C3" FontSize="12"
                         Text="Chỉ lưu khi bạn bấm và xác nhận. Giới hạn 250 ảnh / 200 MB."/>
              <Button Click="OpenSampleLibraryClick" Content="Mở thư viện ảnh đã lưu"
                      HorizontalAlignment="Left" Margin="0,14,0,8"/>
              <Expander Header="Quản lý dữ liệu &amp; xóa ảnh" IsExpanded="False"
                        Foreground="#E8F0F9" Margin="0,6,0,0">
                <StackPanel Margin="8">
                  <Button Click="DeleteTrainingSamplesClick"
                          Content="Xóa toàn bộ mẫu V1.8 (yêu cầu xác nhận)"/>
                  <Button Click="DeleteOldImagesClick" Content="Xóa ảnh từ các phiên bản cũ"/>
                  <TextBlock Name="FolderText" Foreground="#B9CCDF" FontSize="12"
                             Text="Ảnh chỉ được lưu khi bạn chọn."/>
                </StackPanel>
              </Expander>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
        <TabItem Header="Thử AI (tùy chọn)">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="12" MaxWidth="650">
              <TextBlock Text="Thử phân tích với Gemini" FontSize="18" FontWeight="Bold"/>
              <TextBlock Foreground="#F9CF90" Margin="0,6,0,14" FontSize="12"
                         Text="Không cần bật để thu ảnh. Chế độ này gửi ảnh minimap qua AI Cá Nhân đến Gemini khi bạn xác nhận, tối đa 45 ảnh/phiên. Có thể tốn hạn mức hoặc chi phí."/>
              <TextBlock Text="Khoảng cách gửi ảnh"/>
              <ComboBox Name="IntervalBox" SelectedIndex="1" Margin="0,6,0,13">
                <ComboBoxItem Content="30 giây / ảnh" Tag="30"/>
                <ComboBoxItem Content="60 giây / ảnh" Tag="60"/>
                <ComboBoxItem Content="120 giây / ảnh" Tag="120"/>
              </ComboBox>
              <Button Name="StartButton" Click="StartClick"
                      Content="Đồng ý &amp; bắt đầu thử Gemini" Background="#23705B"/>
              <Button Name="StopButton" Click="StopClick" IsEnabled="False"
                      Content="Dừng gửi ảnh / xóa ảnh tạm"/>
              <TextBlock Name="AnalysisText" Text="Chưa có kết quả."
                         Foreground="#E4EDF7" Margin="0,13,0,8"/>
              <TextBlock Name="AnalysisNote" Foreground="#F9CF90" FontSize="12"
                         Text="Kết quả AI chưa được kiểm chứng; không phát thành cảnh báo vị trí đối thủ trong trận."/>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
      </TabControl>
    </Grid>
    <Border Grid.Row="2" Background="#1D3146" CornerRadius="7" Padding="10" Margin="0,10,0,0">
      <TextBlock Name="StatusText" Text="Chưa bật. Chưa chụp hay gửi ảnh."
                 Foreground="#8FE1C3" FontSize="12"/>
    </Border>
  </Grid>
</Window>