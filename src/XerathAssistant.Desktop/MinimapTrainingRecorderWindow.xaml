<Window x:Class="XerathAssistant.Desktop.MinimapTrainingRecorderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thu thập ảnh minimap để luyện tập AI · Không theo dõi rừng trực tiếp"
        Width="760" Height="440" MinWidth="600" MinHeight="380"
        Background="#0B1521" FontFamily="Segoe UI">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24" MaxWidth="880">
      <TextBlock Text="CHUẨN BỊ DỮ LIỆU CHO AI QUAN SÁT" FontWeight="Bold" FontSize="21"
                 Foreground="White" Margin="0,0,0,12"/>
      <TextBlock TextWrapping="Wrap" Foreground="#D4E3F5" FontSize="14" Margin="0,0,0,12"
                 Text="Chỉ khi bạn bấm Bắt đầu, công cụ mới lưu ảnh phần minimap ở góc dưới bên phải của cửa sổ Liên Minh đang được chọn, mỗi 3 giây (tối đa 120 ảnh). Không chụp màn hình các ứng dụng khác; không gửi ảnh lên mạng hoặc tới Gemini/OpenAI. Hãy dùng trận luyện tập hoặc video xem lại."/>
      <TextBlock TextWrapping="Wrap" Foreground="#F9CF90" Margin="0,0,0,12"
                 Text="Đây là công cụ thu thập ảnh để kiểm thử và gán nhãn, CHƯA phải AI nhận diện rừng địch hoặc giao tranh. Không hiện cảnh báo vị trí đối thủ trong trận, không đọc bộ nhớ hoặc điều khiển game. Ảnh vẫn có thể chứa thông tin hiển thị trên minimap; chỉ chia sẻ nếu bạn đồng ý."/>
      <WrapPanel Margin="0,0,0,10">
        <Button Name="StartButton" Content="Bắt đầu thu ảnh luyện tập" Click="StartClick"
                Background="#23705B" Foreground="White" Padding="14,10" Margin="0,0,8,8"/>
        <Button Name="StopButton" Content="Dừng thu ảnh" Click="StopClick"
                IsEnabled="False" Background="#344B65" Foreground="White"
                Padding="14,10" Margin="0,0,8,8"/>
        <Button Content="Mở thư mục ảnh đã lưu" Click="OpenFolderClick"
                Background="#344B65" Foreground="White" Padding="14,10" Margin="0,0,8,8"/>
      </WrapPanel>
      <TextBlock Name="StatusText" Text="Chưa bật thu ảnh. Không có dữ liệu nào được chụp."
                 TextWrapping="Wrap" Foreground="#8FE1C3" Margin="0,0,0,12"/>
      <TextBlock Name="FolderText" Foreground="#AFC3D8" TextWrapping="Wrap" FontSize="12"
                 Text="Ảnh sẽ được lưu trong thư mục cục bộ của ứng dụng."/>
      <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" Foreground="#AFC3D8"
                 Text="Cách thử: nhấn Bắt đầu → chuyển sang cửa sổ Liên Minh (chế độ Cửa sổ hoặc Không viền) → chơi trận luyện tập → quay lại đây và nhấn Dừng → mở thư mục ảnh. Bạn phải tự xóa ảnh nếu không còn muốn giữ."/>
    </StackPanel>
  </ScrollViewer>
</Window>