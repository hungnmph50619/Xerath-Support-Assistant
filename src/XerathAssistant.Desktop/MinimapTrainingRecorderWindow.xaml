<Window x:Class="XerathAssistant.Desktop.MinimapTrainingRecorderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mắt nhìn AI V1.8 · Xem minimap, thu mẫu và gắn nhãn"
        Width="1200" Height="790" MinWidth="980" MinHeight="650"
        WindowStartupLocation="CenterScreen" Background="#0D1724" FontFamily="Segoe UI"
        Foreground="#ECF4FC">
  <Window.Resources>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="#ECF4FC"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="12,7"/>
      <Setter Property="MinHeight" Value="34"/>
      <Setter Property="Margin" Value="0,0,8,8"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Background" Value="#294763"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="White"/>
      <Setter Property="Foreground" Value="#162335"/>
      <Setter Property="Padding" Value="7,5"/>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Background" Value="White"/>
      <Setter Property="Foreground" Value="#162335"/>
      <Setter Property="Padding" Value="6,4"/>
      <Setter Property="MinHeight" Value="34"/>
    </Style>
    <Style TargetType="TabItem">
      <Setter Property="Padding" Value="12,9"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
  </Window.Resources>
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Margin="0,0,0,14">
      <TextBlock Text="MẮT NHÌN AI · MINIMAP" FontSize="22" FontWeight="Bold"/>
      <TextBlock Text="Ảnh ở bên trái luôn hiển thị cạnh nút điều chỉnh. Làm theo thứ tự: 1. Kiểm tra minimap → 2. Thu ảnh → 3. Chọn ảnh cần lưu."
                 Foreground="#AFC4DC" FontSize="13" Margin="0,4,0,0"/>
    </StackPanel>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="450"/>
        <ColumnDefinition Width="14"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" CornerRadius="10" Padding="12" Background="#15283B">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="ẢNH MINIMAP ĐANG XEM" FontWeight="Bold" FontSize="15"/>
            <TextBlock Text="Ảnh sẽ hiện ngay tại đây sau khi bạn quay lại từ game; không phải kéo xuống tìm ảnh."
                       Foreground="#B5C9DD" FontSize="12" Margin="0,4,0,0"/>
          </StackPanel>
          <Border Grid.Row="1" Background="#090F17" CornerRadius="7" BorderBrush="#34516A"
                  BorderThickness="1" MinHeight="250">
            <Grid>
              <TextBlock Text="Chưa có ảnh. Nhấn “Xem trước”, chuyển về game 2–3 giây rồi quay lại."
                         HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                         MaxWidth="285" Foreground="#849FB9" FontSize="13"/>
              <Image Name="SamplePreview" Width="420" Height="420" MaxWidth="420"
                     MaxHeight="420" Stretch="Uniform" HorizontalAlignment="Center"
                     VerticalAlignment="Center" Cursor="Cross"
                     MouseLeftButtonDown="SamplePreviewClick"/>
            </Grid>
          </Border>
          <TextBlock Grid.Row="2" Name="MarkCoordinateStatus"
                     Text="Khi gắn nhãn: nhấp trực tiếp vào biểu tượng nhìn rõ trong ảnh."
                     Foreground="#8FE1C3" FontSize="12" Margin="0,9,0,5"/>
          <TextBlock Grid.Row="3" Foreground="#F9CF90" FontSize="12"
                     Text="Ảnh chỉ giữ trong RAM, trừ khi bạn tự bấm Lưu mẫu. Không đánh dấu vị trí tướng đang khuất tầm nhìn."/>
        </Grid>
      </Border>
      <TabControl Grid.Column="2" Name="WorkflowTabs" SelectedIndex="0"
                  Background="#15283B" BorderThickness="0">
        <TabItem Header="1 · Căn khung">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="12" MaxWidth="660">
              <TextBlock Text="Căn vùng minimap một lần" FontSize="19" FontWeight="Bold"/>
              <TextBlock Text="Bấm xem trước → chuyển về game 2–3 giây → quay lại nhìn ảnh BÊN TRÁI. Nếu còn lệch, chỉnh 4 thanh bên dưới rồi xem lại."
                         Foreground="#B5C9DD" FontSize="13" Margin="0,6,0,13"/>
              <Button Click="PresetCropClick" HorizontalAlignment="Left"
                      Content="Thử khung gợi ý cho minimap góc phải"
                      Background="#294763"/>
              <TextBlock Text="Điều chỉnh nếu ảnh còn thiếu mép hoặc lẫn quá nhiều địa hình:"
                         Foreground="#D8E6F5" Margin="0,8,0,5" FontSize="13"/>
              <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="14"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock Text="Mép trái (%)" FontWeight="SemiBold"/>
                  <Slider Name="CropLeftSlider" ValueChanged="CropSliderChanged"
                          Minimum="0" Maximum="90" Value="78" TickFrequency="1"
                          IsSnapToTickEnabled="True" AutoToolTipPlacement="TopLeft" Margin="0,4,0,13"/>
                  <TextBlock Text="Chiều rộng (%)" FontWeight="SemiBold"/>
                  <Slider Name="CropWidthSlider" ValueChanged="CropSliderChanged"
                          Minimum="8" Maximum="50" Value="22" TickFrequency="1"
                          IsSnapToTickEnabled="True" AutoToolTipPlacement="TopLeft" Margin="0,4,0,6"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="Mép trên (%)" FontWeight="SemiBold"/>
                  <Slider Name="CropTopSlider" ValueChanged="CropSliderChanged"
                          Minimum="0" Maximum="90" Value="70" TickFrequency="1"
                          IsSnapToTickEnabled="True" AutoToolTipPlacement="TopLeft" Margin="0,4,0,13"/>
                  <TextBlock Text="Chiều cao (%)" FontWeight="SemiBold"/>
                  <Slider Name="CropHeightSlider" ValueChanged="CropSliderChanged"
                          Minimum="8" Maximum="50" Value="30" TickFrequency="1"
                          IsSnapToTickEnabled="True" AutoToolTipPlacement="TopLeft" Margin="0,4,0,6"/>
                </StackPanel>
              </Grid>
              <Button Name="PreviewCropButton" Click="PreviewCropClick"
                      Content="1. Xem trước ảnh (không gửi AI)" Background="#315F84"/>
              <Button Name="SaveCropButton" Click="SaveCropClick" IsEnabled="False"
                      Content="2. Ảnh đúng minimap → Lưu khung" Background="#23705B"/>
              <TextBlock Name="CropStatusText" Foreground="#8FE1C3" Margin="0,8,0,8"
                         Text="Chưa có vùng minimap được kiểm tra."/>
              <Border Background="#23364B" CornerRadius="7" Padding="11" Margin="0,5,0,0">
                <StackPanel>
                  <TextBlock Text="Sau khi lưu khung" FontWeight="SemiBold"/>
                  <TextBlock Text="Chọn tab “2 · Thu &amp; lưu” để thu 5 ảnh trong RAM mà không cần Gemini. Không cần cài AI Cá Nhân cho bước đó."
                             Foreground="#CADBED" Margin="0,5,0,0"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
        <TabItem Header="2 · Thu &amp; lưu">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="12" MaxWidth="660">
              <TextBlock Text="Thu ảnh không cần Gemini" FontSize="19" FontWeight="Bold"/>
              <TextBlock Text="Bấm Thu 5 ảnh → chuyển về game khoảng 10–15 giây → quay lại chọn từng khung. Ảnh sẽ hiện ngay bên trái."
                         Foreground="#B5C9DD" Margin="0,5,0,12"/>
              <WrapPanel>
                <Button Name="SequenceStartButton" Click="StartSequenceClick"
                        Content="Thu 5 ảnh trong RAM" Background="#23705B"/>
                <Button Name="SequenceClearButton" Click="ClearSequenceClick"
                        Content="Xóa chuỗi RAM"/>
              </WrapPanel>
              <ComboBox Name="SequenceFrameBox" SelectionChanged="SequenceFrameChanged"
                        Margin="0,2,0,7" MinWidth="260"/>
              <TextBlock Name="SequenceStatus" Foreground="#8FE1C3" FontSize="12"
                         Text="Chưa giữ chuỗi ảnh nào."/>
              <Border Background="#293F55" CornerRadius="8" Padding="10" Margin="0,12,0,10">
                <StackPanel>
                  <TextBlock Text="Gắn nhãn cho ảnh đang xem (tùy chọn)" FontWeight="SemiBold"/>
                  <TextBlock Text="Nhấp vào biểu tượng trong ảnh BÊN TRÁI, điền tên tướng và chọn đội/vai trò nếu bạn biết chắc."
                             Foreground="#C8D7E6" FontSize="12" Margin="0,4,0,8"/>
                  <TextBox Name="ChampionNameBox" MaxLength="50" Margin="0,0,0,6"
                           ToolTip="Tên tướng nhìn thấy được; nếu không chắc, không đánh dấu."/>
                  <WrapPanel>
                    <ComboBox Name="ChampionTeamBox" SelectedIndex="2" Width="165" Margin="0,0,8,7">
                      <ComboBoxItem Content="Đồng minh" Tag="ally"/>
                      <ComboBoxItem Content="Đối thủ" Tag="enemy"/>
                      <ComboBoxItem Content="Chưa rõ đội" Tag="unknown"/>
                    </ComboBox>
                    <ComboBox Name="ChampionRoleBox" SelectedIndex="5" Width="165" Margin="0,0,8,7">
                      <ComboBoxItem Content="Top" Tag="top"/>
                      <ComboBoxItem Content="Rừng" Tag="jungle"/>
                      <ComboBoxItem Content="Mid" Tag="mid"/>
                      <ComboBoxItem Content="Bot/ADC" Tag="bottom"/>
                      <ComboBoxItem Content="Support" Tag="support"/>
                      <ComboBoxItem Content="Chưa rõ vai trò" Tag="unknown"/>
                    </ComboBox>
                    <Button Click="AddChampionMarkClick" Content="Thêm điểm"/>
                    <Button Click="ClearChampionMarksClick" Content="Xóa điểm"/>
                  </WrapPanel>
                  <TextBlock Name="ChampionMarksStatus"
                             Text="Chưa có điểm đánh dấu." Foreground="#AFC3D8" FontSize="12"/>
                </StackPanel>
              </Border>
              <TextBlock Text="Bạn quan sát được gì trong ảnh?" FontWeight="SemiBold" Margin="0,2,0,5"/>
              <ComboBox Name="EvidenceTypeBox" SelectedIndex="2" Margin="0,0,0,7">
                <ComboBoxItem Tag="visible-observation" Content="Quan sát trực tiếp (nhìn rõ biểu tượng)"/>
                <ComboBoxItem Tag="hypothesis" Content="Giả thuyết, chưa xác minh"/>
                <ComboBoxItem Tag="uncertain" Content="Không xác định / ảnh chưa rõ"/>
              </ComboBox>
              <TextBox Name="SampleLabelBox" MinHeight="56" MaxLength="300"
                       TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,7"/>
              <Button Name="SaveSampleButton" IsEnabled="False" Click="SaveSampleClick"
                      Content="Lưu duy nhất ảnh đã chọn + ghi chú" Background="#23705B"/>
              <TextBlock Name="TrainingStatus" Foreground="#8FE1C3" FontSize="12"
                         Text="Chỉ lưu khi bạn bấm nút và xác nhận. Giới hạn: 250 ảnh / 200 MB."/>
              <Button Click="OpenSampleLibraryClick" Content="Mở thư viện ảnh đã lưu" Margin="0,10,8,8"/>
              <Expander Header="Quản lý và xóa dữ liệu" Foreground="#E8F0F9" Margin="0,6,0,0">
                <StackPanel Margin="8">
                  <Button Click="DeleteTrainingSamplesClick" Content="Xóa toàn bộ mẫu V1.8 (cần xác nhận)"/>
                  <Button Click="DeleteOldImagesClick" Content="Xóa ảnh minimap đã lưu từ phiên bản cũ"/>
                  <TextBlock Name="FolderText" Foreground="#B5C9DD" FontSize="12"
                             Text="Ảnh V1.8 chỉ lưu khi bạn chọn."/>
                </StackPanel>
              </Expander>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
        <TabItem Header="3 · AI (tùy chọn)">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="12" MaxWidth="660">
              <TextBlock Text="Thử phân tích với Gemini" FontSize="19" FontWeight="Bold"/>
              <TextBlock Text="Bạn KHÔNG cần bật chế độ này để căn minimap, thu 5 ảnh hoặc lưu dữ liệu. Chỉ dùng trong trận luyện tập/xem lại khi bạn đồng ý gửi tối đa 45 ảnh qua AI Cá Nhân đến Gemini."
                         Foreground="#F9CF90" Margin="0,7,0,15"/>
              <TextBlock Text="Khoảng cách giữa các ảnh gửi" FontWeight="SemiBold"/>
              <ComboBox Name="IntervalBox" SelectedIndex="1" Margin="0,5,0,12">
                <ComboBoxItem Content="30 giây / ảnh" Tag="30"/>
                <ComboBoxItem Content="60 giây / ảnh (mặc định)" Tag="60"/>
                <ComboBoxItem Content="120 giây / ảnh" Tag="120"/>
              </ComboBox>
              <Button Name="StartButton" Click="StartClick" Background="#23705B"
                      Content="Đồng ý và bắt đầu phân tích với Gemini"/>
              <Button Name="StopButton" Click="StopClick" IsEnabled="False"
                      Content="Dừng phân tích / giải phóng ảnh RAM"/>
              <TextBlock Name="AnalysisText" Text="Chưa có kết quả." Margin="0,14,0,6"
                         Foreground="#E4EDF7"/>
              <TextBlock Name="AnalysisNote" Foreground="#F9CF90"
                         Text="Kết quả AI chưa được xác minh; không dùng làm cảnh báo vị trí đối thủ trong trận."/>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
      </TabControl>
    </Grid>
    <Border Grid.Row="2" Background="#1D3146" CornerRadius="7" Padding="11"
            Margin="0,12,0,0">
      <TextBlock Name="StatusText" Text="Chưa bật. Chưa chụp hay gửi ảnh."
                 Foreground="#8FE1C3" FontSize="13"/>
    </Border>
  </Grid>
</Window>