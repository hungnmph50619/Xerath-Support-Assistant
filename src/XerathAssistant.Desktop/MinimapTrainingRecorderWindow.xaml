<Window x:Class="XerathAssistant.Desktop.MinimapTrainingRecorderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mắt nhìn AI V1.8 · Phân tích và chọn lưu mẫu minimap"
        Width="880" Height="760" MinWidth="650" MinHeight="530"
        Background="#0B1521" FontFamily="Segoe UI">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="22" MaxWidth="950">
      <TextBlock Text="MẮT NHÌN AI V1.8 · CHỌN LƯU MẪU HUẤN LUYỆN" FontWeight="Bold" FontSize="21"
                 Foreground="White" Margin="0,0,0,12"/>
      <TextBlock TextWrapping="Wrap" Foreground="#D4E3F5" FontSize="14" Margin="0,0,0,10"
                 Text="Khi bạn chủ động bật chế độ thử nghiệm, ứng dụng chụp duy nhất vùng minimap đang HIỂN THỊ của cửa sổ trận Liên Minh được chọn, đưa ảnh trực tiếp qua bộ nhớ tới AI cá nhân để phân tích rồi giải phóng ảnh. Mặc định không lưu tệp ảnh mới; chỉ ảnh bạn chủ động chọn mới được lưu để gắn nhãn. Chế độ tự dừng khi đóng game, hết giới hạn hoặc bạn bấm Dừng."/>
      <TextBlock TextWrapping="Wrap" Foreground="#F9CF90" Margin="0,0,0,14"
                 Text="MỖI ẢNH được gửi từ máy bạn qua AI cá nhân tới Google Gemini theo cấu hình hiện có; có thể phát sinh hạn mức hoặc chi phí. Không có mô hình AI chạy hoàn toàn offline ở chế độ này. Chỉ thử ở trận luyện tập/xem lại. Kết quả có thể sai và KHÔNG được gửi thành cảnh báo vị trí đối thủ trên HUD hoặc giọng nói trong trận."/>
      <WrapPanel Margin="0,0,0,12">
        <TextBlock VerticalAlignment="Center" Text="Chu kỳ gửi ảnh:" Margin="0,0,9,0"/>
        <ComboBox Name="IntervalBox" Width="200" SelectedIndex="1" Margin="0,0,15,0">
          <ComboBoxItem Content="30 giây / ảnh" Tag="30"/>
          <ComboBoxItem Content="60 giây / ảnh (mặc định)" Tag="60"/>
          <ComboBoxItem Content="120 giây / ảnh" Tag="120"/>
        </ComboBox>
        <TextBlock VerticalAlignment="Center" Text="Giới hạn: 45 ảnh/phiên; mỗi lần chỉ gửi 1 ảnh." Foreground="#AFC3D8"/>
      </WrapPanel>
      <WrapPanel Margin="0,0,0,8">
        <Button Name="StartButton" Content="Bắt đầu phân tích (cần đồng ý gửi Gemini)" Click="StartClick"
                Background="#23705B" Foreground="White" Padding="14,10" Margin="0,0,8,8"/>
        <Button Name="StopButton" Content="Dừng ngay / xóa bộ nhớ phiên" Click="StopClick"
                IsEnabled="False" Background="#344B65" Foreground="White" Padding="14,10" Margin="0,0,8,8"/>
        <Button Content="Xóa ảnh minimap ĐÃ LƯU từ các phiên cũ" Click="DeleteOldImagesClick"
                Background="#564236" Foreground="White" Padding="14,10" Margin="0,0,8,8"/>
      </WrapPanel>
      <TextBlock Name="StatusText" Text="Chưa bật. Không chụp hay gửi ảnh."
                 TextWrapping="Wrap" Foreground="#8FE1C3" Margin="0,0,0,10"/>
      <Border Background="#122339" CornerRadius="8" Padding="12">
        <StackPanel>
          <TextBlock Text="Kết quả ảnh gần nhất (chỉ trong RAM)" FontWeight="SemiBold" FontSize="16"
                     Margin="0,0,0,6"/>
          <TextBlock Name="AnalysisText" Text="Chưa có kết quả." TextWrapping="Wrap"
                     Foreground="#D4E3F5" FontSize="13"/>
          <TextBlock Name="AnalysisNote" Margin="0,8,0,0" TextWrapping="Wrap"
                     Foreground="#F9CF90" FontSize="12"
                     Text="Kết quả chưa được xác minh. Không kết luận ai đi Rừng/Mid chỉ từ vị trí trên một ảnh."/>
        </StackPanel>
      </Border>
      <Border Background="#122339" CornerRadius="8" Padding="12" Margin="0,12,0,0">
        <StackPanel>
          <TextBlock Text="BỘ MẪU V1.8 · CHỈ LƯU KHI BẠN XÁC NHẬN" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,7"/>
          <TextBlock TextWrapping="Wrap" Foreground="#F9CF90" FontSize="12" Margin="0,0,0,8"
                     Text="Ảnh bên dưới chỉ giữ trong RAM đến lần phân tích kế tiếp hoặc khi bấm Dừng. Kiểm tra vùng cắt có đúng minimap không; ảnh có thể chứa chi tiết bên cạnh. Không mặc định lưu. Nhãn do bạn ghi là mô tả thủ công, CHƯA phải dữ liệu nhận diện tướng có tọa độ được kiểm chứng."/>
          <Image Name="SamplePreview" MaxWidth="260" MaxHeight="220" HorizontalAlignment="Left"
                 Stretch="Uniform" Margin="0,0,0,8"/>
          <TextBlock Text="Minimap có thể gợi ý Mid rời đường hoặc Rừng tiến gần bot khi có biểu tượng hiển thị qua nhiều ảnh; đây chưa phải bằng chứng họ sẽ gank. Không gắn nhãn chắc chắn địch trong bụi nếu không thấy họ được lộ tầm nhìn." TextWrapping="Wrap" FontSize="12" Foreground="#AFC3D8"/>
          <TextBlock Text="Phân loại thông tin: quan sát trực tiếp hay chỉ là suy luận?" Foreground="#D4E3F5" FontSize="12" Margin="0,6,0,4"/>
          <ComboBox Name="EvidenceTypeBox" SelectedIndex="2" Margin="0,0,0,8" Width="440" HorizontalAlignment="Left">
            <ComboBoxItem Tag="visible-observation" Content="Tôi nhìn thấy trực tiếp biểu tượng trên ảnh"/>
            <ComboBoxItem Tag="hypothesis" Content="Giả thuyết (ví dụ: Rừng có thể gank, Mid có thể đảo đường)"/>
            <ComboBoxItem Tag="uncertain" Content="Không xác định: ảnh mờ, khuất hoặc không đủ dữ liệu"/>
          </ComboBox>
          <TextBox Name="SampleLabelBox" MinHeight="50" MaxLength="300" TextWrapping="Wrap" AcceptsReturn="True"
                   VerticalScrollBarVisibility="Auto" Margin="0,7,0,8"/>
          <WrapPanel>
            <Button Name="SaveSampleButton" IsEnabled="False" Click="SaveSampleClick"
                    Content="Lưu duy nhất ảnh đang xem + nhãn đã ghi" Padding="12,8" Margin="0,0,8,8"
                    Background="#23705B" Foreground="White"/>
            <Button Click="DeleteTrainingSamplesClick" Content="Xóa toàn bộ mẫu V1.8 (cần xác nhận)"
                    Padding="12,8" Margin="0,0,8,8" Background="#564236" Foreground="White"/>
          </WrapPanel>
          <TextBlock Name="TrainingStatus" TextWrapping="Wrap" Foreground="#8FE1C3" FontSize="12"
                     Text="Giới hạn dữ liệu lưu thủ công: tối đa 250 ảnh và 200 MB trên máy. Không tự xóa mẫu đã lưu."/>
        </StackPanel>
      </Border>
      <TextBlock Name="FolderText" Margin="0,13,0,0" Foreground="#AFC3D8" TextWrapping="Wrap" FontSize="12"
                 Text="Ảnh cũ từng tạo trước khi nâng cấp KHÔNG tự biến mất. Bấm nút xóa ảnh cũ để xác nhận dọn chúng."/>
    </StackPanel>
  </ScrollViewer>
</Window>